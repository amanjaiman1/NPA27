# ── Cloud sync (Supabase) ──────────────────────────────────────────
# Copy this file to `.env.local` and fill in your project's values.
# Find both under: Supabase Dashboard → Project Settings → API.
#
# These are PUBLIC values (safe to expose in the browser). Data is
# protected by Row Level Security, not by hiding the anon key.
#
# Leaving these unset runs the app in local-only mode: no accounts, one user,
# data saved only in this browser. Set them to enable sign-up and sign-in.
# Supabase also needs the SQL in supabase/ applied and its auth settings
# configured — see the README.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key


# ── Background push (optional) ──────────────────────────────────────
# Lets notifications arrive when the app is CLOSED. Without these the app
# still notifies you perfectly well while it is open — see docs/notifications.md.
#
# Requires cloud sync above to be configured: the dispatcher reads your synced
# snapshot from Supabase, so a local-only install has nothing to push from.
#
# Generate the key pair once with:   node scripts/generate-vapid.mjs
# Regenerating it silences every device that already subscribed.

# Public — inlined into the browser bundle at build time. Safe to expose.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Secret. Server only — never prefix a secret with NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=

# A contact the push service can reach about your sends. mailto: or https:.
VAPID_SUBJECT=mailto:you@example.com

# Supabase service-role key, from Dashboard → Project Settings → API.
# Bypasses Row Level Security. Used only by server routes: account deletion
# (/api/account/delete) and the push dispatcher, which reads every subscriber's
# trimmed snapshot. Secret — this must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the scheduler sends as `Authorization: Bearer <secret>` when it
# calls /api/push/dispatch. Any long random string; without it that route
# refuses to run.
CRON_SECRET=


# ── Public site and SEO (optional) ──────────────────────────────────
# All public, all built into the pages: redeploy after changing any of them.
# Step-by-step setup: docs/SEO_SETUP_GUIDE.md.

# The site's main address, with https:// and no trailing slash, e.g.
# https://example.com. Canonical links, the sitemap, robots.txt and social
# previews all use it. Without it, Vercel's production domain is used (and
# http://localhost:3000 locally). Only Vercel's production deployment is ever
# indexed; previews always answer noindex.
NEXT_PUBLIC_SITE_URL=

# Shown on /contact. Leave empty to offer GitHub issues only.
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Analytics 4 measurement ID (G-…). Empty means no analytics and no
# consent banner. When set, it loads only after a visitor agrees, only on the
# public pages and sign-in screens, never inside the app.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Bing Webmaster Tools: the content value of its msvalidate.01 meta tag.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

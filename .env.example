# ── Cloud sync (Supabase) ──────────────────────────────────────────
# Copy this file to `.env.local` and fill in your project's values.
# Find both under: Supabase Dashboard → Project Settings → API.
#
# These are PUBLIC values (safe to expose in the browser). Data is
# protected by Row Level Security, not by hiding the anon key.
#
# Leaving these unset runs the app in local-only mode (browser storage),
# exactly as it behaved before cloud sync was added.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key


# ── Background push (optional) ──────────────────────────────────────
# Lets notifications arrive when the app is CLOSED. Without these the app
# still notifies you perfectly well while it is open — see docs/notifications.md.
#
# Requires cloud sync above to be configured: the dispatcher reads your synced
# snapshot from Supabase, so a local-only install has nothing to push from.
#
# Generate the key pair once with:   node scripts/generate-vapid.mjs
# Regenerating it silences every device that already subscribed.

# Public — inlined into the browser bundle at build time. Safe to expose.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Secret. Server only — never prefix a secret with NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=

# A contact the push service can reach about your sends. mailto: or https:.
VAPID_SUBJECT=mailto:you@example.com

# Supabase service-role key, from Dashboard → Project Settings → API.
# Bypasses Row Level Security, so the dispatcher can read every subscriber's
# snapshot. Secret — this must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the scheduler sends as `Authorization: Bearer <secret>` when it
# calls /api/push/dispatch. Any long random string; without it that route
# refuses to run.
CRON_SECRET=

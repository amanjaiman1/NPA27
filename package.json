{
  "name": "upsc-chronicle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "icons": "python3 scripts/generate-icons.py",
    "check:classes": "node scripts/check-opacity-utilities.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node scripts/test-db.mjs",
    "mock:supabase": "node scripts/mock-supabase.mjs",
    "test:e2e": "node tests/e2e/accounts.e2e.mjs",
    "test:e2e:admin": "node --import tsx tests/e2e/admin.e2e.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:suggest": "node scripts/seo-suggest.mjs",
    "seo:screenshots": "tsx scripts/seo-screenshots.ts",
    "seo:og": "node scripts/seo-og-image.mjs",
    "perf:measure": "node --import tsx scripts/perf/measure.mjs",
    "perf:compute": "tsx scripts/perf/compute-bench.ts",
    "perf:render": "node --import tsx scripts/perf/render-probe.mjs",
    "perf:bundle": "ANALYZE=json next build && node scripts/perf/bundle-report.mjs --out docs/perf/bundle-latest.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.18.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@next/bundle-analyzer": "14.2.35",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.65.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
